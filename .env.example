# --- AI intelligence layer ---
# Get a free key at https://console.groq.com  (or point at any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- To run fully offline instead: install Ollama, `ollama pull llama3.1:8b`, then ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

ENABLE_WEB_SEARCH=true
